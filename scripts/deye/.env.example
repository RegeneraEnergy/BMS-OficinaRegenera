# Plantilla de configuración de los scripts de DeyeCloud.
# Copia este archivo a `.env` (que git ignora) y rellena los valores reales.
# NUNCA pongas aquí valores reales: este archivo SÍ se sube a GitHub.
# En la Raspberry: chmod 600 .env

# Cuenta y aplicación de DeyeCloud (developer.deyecloud.com)
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
DEYE_COMPANY_ID=
DEYE_DEVICE_SN=

# Opcionales (tienen valor por defecto)
# DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
# MONGO_URI=mongodb://localhost:27017
# DB_NAME=Oficina-REGENERA
